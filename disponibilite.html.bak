<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Suivi Disponibilité Flotte & Chauffeurs — Douroub El Djazair</title>
  <meta name="description" content="Tableau de bord de disponibilité temps réel de la flotte, chauffeurs et remorques. SPA Douroub El Djazair.">
  
  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
  
  <!-- FontAwesome 6 -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  
  <!-- ExcelJS for XLSX export -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/exceljs/4.4.0/exceljs.min.js"></script>
  
  <style>
    :root {
      --bg-base: #060910;
      --bg-surface: #0f172a;
      --bg-elevated: #1e293b;
      --bg-hover: #27354f;
      --border: rgba(255, 255, 255, 0.08);
      --border-strong: rgba(255, 255, 255, 0.16);
      --primary: #38bdf8;
      --primary-hover: #0ea5e9;
      --success: #10b981;
      --warning: #f59e0b;
      --danger: #ef4444;
      --purple: #8b5cf6;
      --text-primary: #f8fafc;
      --text-secondary: #94a3b8;
      --text-muted: #64748b;
      --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      --font-mono: 'JetBrains Mono', monospace;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: var(--font-sans);
      background: var(--bg-base);
      color: var(--text-primary);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      overflow-x: hidden;
    }

    /* Top Bar */
    header {
      background: var(--bg-surface);
      border-bottom: 1px solid var(--border);
      padding: 14px 24px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      position: sticky;
      top: 0;
      z-index: 100;
      backdrop-filter: blur(12px);
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .brand-logo {
      width: 38px;
      height: 38px;
      border-radius: 10px;
      background: linear-gradient(135deg, #0284c7, #38bdf8);
      display: flex;
      align-items: center;
      justify-content: center;
      color: #fff;
      font-size: 18px;
      box-shadow: 0 4px 14px rgba(2, 132, 199, 0.4);
    }

    .brand-title {
      font-size: 16px;
      font-weight: 800;
      letter-spacing: -0.3px;
      color: var(--text-primary);
    }

    .brand-subtitle {
      font-size: 11px;
      color: var(--text-secondary);
    }

    .header-actions {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .live-indicator {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 5px 12px;
      background: rgba(16, 185, 129, 0.12);
      border: 1px solid rgba(16, 185, 129, 0.3);
      border-radius: 20px;
      font-size: 11px;
      font-weight: 700;
      color: var(--success);
    }

    .pulse-dot {
      width: 8px;
      height: 8px;
      background: var(--success);
      border-radius: 50%;
      box-shadow: 0 0 8px var(--success);
      animation: livePulse 2s infinite;
    }

    @keyframes livePulse {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.4; transform: scale(0.85); }
    }

    .clock {
      font-family: var(--font-mono);
      font-size: 13px;
      color: var(--text-secondary);
      background: var(--bg-elevated);
      padding: 6px 12px;
      border-radius: 8px;
      border: 1px solid var(--border);
    }

    .btn {
      padding: 7px 14px;
      border-radius: 8px;
      font-size: 12px;
      font-weight: 700;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      transition: all 0.2s ease;
      border: none;
      text-decoration: none;
    }

    .btn-excel {
      background: linear-gradient(135deg, #059669, #10b981);
      color: white;
      box-shadow: 0 4px 12px rgba(16, 185, 129, 0.3);
    }

    .btn-excel:hover { transform: translateY(-1px); }

    .btn-back {
      background: var(--bg-elevated);
      color: var(--text-secondary);
      border: 1px solid var(--border);
    }

    .btn-back:hover { color: var(--text-primary); border-color: var(--border-strong); }

    /* Main Container */
    main {
      flex: 1;
      padding: 24px;
      max-width: 1700px;
      margin: 0 auto;
      width: 100%;
    }

    /* KPI Cards Grid */
    .kpi-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 14px;
      margin-bottom: 24px;
    }

    .kpi-card {
      background: var(--bg-surface);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 16px 18px;
      transition: transform 0.2s ease, border-color 0.2s ease;
      cursor: pointer;
      user-select: none;
    }

    .kpi-card:hover {
      transform: translateY(-2px);
      border-color: var(--border-strong);
    }

    .kpi-label {
      font-size: 11px;
      text-transform: uppercase;
      font-weight: 700;
      letter-spacing: 0.6px;
      color: var(--text-muted);
      margin-bottom: 6px;
    }

    .kpi-value {
      font-size: 28px;
      font-weight: 900;
      letter-spacing: -1px;
    }

    .kpi-sub {
      font-size: 11px;
      color: var(--text-secondary);
      margin-top: 4px;
    }

    /* Filter & Controls Toolbar */
    .toolbar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 14px;
      margin-bottom: 20px;
      flex-wrap: wrap;
      background: var(--bg-surface);
      padding: 14px 18px;
      border-radius: 14px;
      border: 1px solid var(--border);
    }

    .search-wrap {
      display: flex;
      align-items: center;
      gap: 10px;
      background: var(--bg-elevated);
      padding: 8px 14px;
      border-radius: 10px;
      border: 1px solid var(--border);
      flex: 1;
      min-width: 280px;
    }

    .search-wrap input {
      border: none;
      outline: none;
      background: transparent;
      color: var(--text-primary);
      width: 100%;
      font-size: 13px;
    }

    .filter-pills {
      display: flex;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
    }

    .pill {
      padding: 6px 14px;
      border-radius: 20px;
      border: 1px solid var(--border);
      background: var(--bg-elevated);
      color: var(--text-secondary);
      font-size: 12px;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.2s ease;
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }

    .pill:hover {
      color: var(--text-primary);
      border-color: var(--border-strong);
    }

    .pill.active {
      background: var(--primary);
      color: #060910;
      border-color: var(--primary);
      box-shadow: 0 2px 10px rgba(56, 189, 248, 0.3);
    }

    /* Table Styles */
    .table-container {
      background: var(--bg-surface);
      border: 1px solid var(--border);
      border-radius: 14px;
      overflow: hidden;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
    }

    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 12px;
    }

    thead th {
      background: var(--bg-elevated);
      padding: 14px 16px;
      text-align: left;
      font-size: 11px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.6px;
      color: var(--text-muted);
      border-bottom: 2px solid var(--border);
      white-space: nowrap;
    }

    tbody td {
      padding: 14px 16px;
      border-bottom: 1px solid var(--border);
      vertical-align: middle;
    }

    tbody tr {
      transition: background 0.15s ease;
    }

    tbody tr:hover {
      background: var(--bg-hover);
    }

    tbody tr:last-child td {
      border-bottom: none;
    }

    /* Badges & Tags */
    .truck-tag {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      padding: 2px 8px;
      border-radius: 6px;
      font-size: 10px;
      font-weight: 700;
    }

    .tag-imm {
      background: rgba(16, 185, 129, 0.15);
      color: #34d399;
      border: 1px solid rgba(16, 185, 129, 0.3);
    }

    .tag-naftal {
      background: rgba(139, 92, 246, 0.15);
      color: #a78bfa;
      border: 1px solid rgba(139, 92, 246, 0.3);
    }

    .tag-trailer {
      background: rgba(168, 85, 247, 0.15);
      color: #c084fc;
      border: 1px solid rgba(168, 85, 247, 0.3);
    }

    .situation-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 4px 12px;
      border-radius: 20px;
      font-size: 11px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      white-space: nowrap;
    }

    .badge-mission {
      background: rgba(16, 185, 129, 0.15);
      color: #34d399;
      border: 1px solid rgba(16, 185, 129, 0.35);
    }

    .badge-disponible {
      background: rgba(2, 132, 199, 0.15);
      color: #38bdf8;
      border: 1px solid rgba(2, 132, 199, 0.35);
    }

    .badge-maintenance {
      background: rgba(245, 158, 11, 0.15);
      color: #fbbf24;
      border: 1px solid rgba(245, 158, 11, 0.35);
    }

    .badge-repos {
      background: rgba(139, 92, 246, 0.15);
      color: #a78bfa;
      border: 1px solid rgba(139, 92, 246, 0.35);
    }

    .badge-conge {
      background: rgba(148, 163, 184, 0.15);
      color: #cbd5e1;
      border: 1px solid rgba(148, 163, 184, 0.35);
    }

    .call-link {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      color: #38bdf8;
      text-decoration: none;
      font-weight: 700;
      font-family: var(--font-mono);
      font-size: 11px;
    }

    .call-link:hover { text-decoration: underline; }

    /* Card Grid View Mode */
    .cards-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
      gap: 16px;
    }

    .dispo-card {
      background: var(--bg-surface);
      border: 1px solid var(--border);
      border-radius: 14px;
      overflow: hidden;
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .dispo-card:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
    }

    .dispo-card-header {
      padding: 12px 16px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 1px solid var(--border);
    }

    .dispo-card-body {
      padding: 16px;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .info-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 12px;
    }

    .info-label {
      color: var(--text-muted);
      font-weight: 600;
    }

    .info-value {
      color: var(--text-primary);
      font-weight: 700;
    }

    /* Empty state */
    .empty-state {
      padding: 50px 20px;
      text-align: center;
      color: var(--text-muted);
    }

    .empty-state i {
      font-size: 36px;
      margin-bottom: 12px;
      opacity: 0.3;
      display: block;
    }
  </style>
</head>
<body>

  <header>
    <div class="brand">
      <div class="brand-logo"><i class="fa-solid fa-truck-fast"></i></div>
      <div>
        <div class="brand-title">Douroub FleetOS — Disponibilité Flotte & Chauffeurs</div>
        <div class="brand-subtitle">Supervision opérationnelle en temps réel</div>
      </div>
    </div>
    <div class="header-actions">
      <div class="live-indicator">
        <span class="pulse-dot"></span>
        <span id="liveStatusText">TEMPS RÉEL</span>
      </div>
      <div class="clock" id="clockDisplay">--:--:--</div>
      <button class="btn btn-excel" onclick="exportToExcel()">
        <i class="fa-solid fa-file-excel"></i> Export Excel
      </button>
      <a href="index.html" class="btn btn-back">
        <i class="fa-solid fa-arrow-left"></i> Retour Dashboard
      </a>
    </div>
  </header>

  <main>
    <!-- KPI Counters -->
    <div class="kpi-grid">
      <div class="kpi-card" style="border-left: 4px solid var(--primary);" onclick="setFilter('all')">
        <div class="kpi-label">Total Véhicules</div>
        <div class="kpi-value" id="kpiTotal" style="color: var(--text-primary);">--</div>
        <div class="kpi-sub"><span id="kpiDriversCount">--</span> chauffeurs enregistrés</div>
      </div>
      <div class="kpi-card" style="border-left: 4px solid #10b981;" onclick="setFilter('mission')">
        <div class="kpi-label" style="color: #10b981; display:flex; align-items:center; gap:6px;">
          <span class="pulse-dot" style="width:6px; height:6px;"></span> En Mission
        </div>
        <div class="kpi-value" id="kpiMission" style="color: #10b981;">--</div>
        <div class="kpi-sub">En route / En livraison</div>
      </div>
      <div class="kpi-card" style="border-left: 4px solid #0284c7;" onclick="setFilter('disponible')">
        <div class="kpi-label" style="color: #38bdf8;">Disponible au Parc</div>
        <div class="kpi-value" id="kpiDispo" style="color: #38bdf8;">--</div>
        <div class="kpi-sub">Prêt pour affectation</div>
      </div>
      <div class="kpi-card" style="border-left: 4px solid #f59e0b;" onclick="setFilter('maintenance')">
        <div class="kpi-label" style="color: #f59e0b;">En Maintenance</div>
        <div class="kpi-value" id="kpiMaint" style="color: #f59e0b;">--</div>
        <div class="kpi-sub">Atelier / Réparation</div>
      </div>
      <div class="kpi-card" style="border-left: 4px solid #8b5cf6;" onclick="setFilter('repos')">
        <div class="kpi-label" style="color: #a78bfa;">Découchage / Repos</div>
        <div class="kpi-value" id="kpiRepos" style="color: #a78bfa;">--</div>
        <div class="kpi-sub">Nuit / Arrêt prolongé</div>
      </div>
      <div class="kpi-card" style="border-left: 4px solid #64748b;" onclick="setFilter('conge')">
        <div class="kpi-label" style="color: #94a3b8;">Congé / Indisponible</div>
        <div class="kpi-value" id="kpiConge" style="color: #cbd5e1;">--</div>
        <div class="kpi-sub">Congé ou arrêt maladie</div>
      </div>
    </div>

    <!-- Toolbar Filters -->
    <div class="toolbar">
      <div class="search-wrap">
        <i class="fa-solid fa-magnifying-glass" style="color: var(--text-muted);"></i>
        <input type="text" id="searchInput" placeholder="Rechercher camion, chauffeur, tél, remorque, ville..." oninput="handleSearch()">
      </div>
      <div class="filter-pills" id="filterPills">
        <button class="pill active" data-filter="all" onclick="setFilter('all')">Tous</button>
        <button class="pill" data-filter="mission" onclick="setFilter('mission')"><i class="fa-solid fa-circle" style="color:#10b981; font-size:7px;"></i> En Mission</button>
        <button class="pill" data-filter="disponible" onclick="setFilter('disponible')"><i class="fa-solid fa-circle" style="color:#38bdf8; font-size:7px;"></i> Disponible</button>
        <button class="pill" data-filter="maintenance" onclick="setFilter('maintenance')"><i class="fa-solid fa-circle" style="color:#f59e0b; font-size:7px;"></i> Maintenance</button>
        <button class="pill" data-filter="repos" onclick="setFilter('repos')"><i class="fa-solid fa-circle" style="color:#a78bfa; font-size:7px;"></i> Découchage</button>
        <button class="pill" data-filter="conge" onclick="setFilter('conge')"><i class="fa-solid fa-circle" style="color:#94a3b8; font-size:7px;"></i> Congé</button>
      </div>
      <div style="display:flex; align-items:center; gap:8px;">
        <select id="wilayaFilter" onchange="render()" style="background:var(--bg-elevated); color:var(--text-primary); border:1px solid var(--border); padding:7px 12px; border-radius:8px; font-size:12px;">
          <option value="all">Toutes Wilayas</option>
        </select>
        <button class="btn btn-back" id="viewModeBtn" onclick="toggleViewMode()" title="Basculer vue tableau / cartes">
          <i class="fa-solid fa-table"></i>
        </button>
      </div>
    </div>

    <!-- Content Container -->
    <div id="contentContainer">
      <div class="empty-state">
        <i class="fa-solid fa-sync fa-spin"></i>
        <div>Chargement des données de disponibilité...</div>
      </div>
    </div>
  </main>

  <script>
    // State
    let availabilityData = { counts: {}, items: [] };
    let currentFilter = 'all';
    let searchQuery = '';
    let viewMode = 'table'; // 'table' or 'cards'
    let pollInterval = null;

    // Clock
    function updateClock() {
      const now = new Date();
      document.getElementById('clockDisplay').textContent = now.toLocaleTimeString('fr-FR');
    }
    setInterval(updateClock, 1000);
    updateClock();

    // Fetch availability from backend API
    async function fetchAvailability() {
      try {
        const res = await fetch('/api/fleet/availability');
        if (res.ok) {
          availabilityData = await res.json();
          updateKPIs();
          populateWilayas();
          render();
        }
      } catch (err) {
        console.warn('Erreur chargement disponibilité:', err);
      }
    }

    // Update KPIs
    function updateKPIs() {
      const c = availabilityData.counts || {};
      document.getElementById('kpiTotal').textContent = c.total || 0;
      document.getElementById('kpiMission').textContent = c.mission || 0;
      document.getElementById('kpiDispo').textContent = c.disponible || 0;
      document.getElementById('kpiMaint').textContent = c.maintenance || 0;
      document.getElementById('kpiRepos').textContent = c.repos || 0;
      document.getElementById('kpiConge').textContent = c.conge || 0;
      document.getElementById('kpiDriversCount').textContent = availabilityData.driversCount || 0;
    }

    // Populate Wilaya select
    function populateWilayas() {
      const select = document.getElementById('wilayaFilter');
      const cur = select.value;
      const wilayas = new Set();
      (availabilityData.items || []).forEach(item => {
        if (item.locationCity && item.locationCity !== 'En route') wilayas.add(item.locationCity);
      });
      const sorted = Array.from(wilayas).sort();
      let html = '<option value="all">Toutes Wilayas</option>';
      sorted.forEach(w => {
        html += `<option value="${w}" ${w === cur ? 'selected' : ''}>${w}</option>`;
      });
      select.innerHTML = html;
    }

    // Filters
    function setFilter(filter) {
      currentFilter = filter;
      document.querySelectorAll('#filterPills .pill').forEach(p => {
        p.classList.toggle('active', p.getAttribute('data-filter') === filter);
      });
      render();
    }

    function handleSearch() {
      searchQuery = document.getElementById('searchInput').value.trim().toLowerCase();
      render();
    }

    function toggleViewMode() {
      viewMode = viewMode === 'table' ? 'cards' : 'table';
      document.getElementById('viewModeBtn').innerHTML = viewMode === 'table' ? '<i class="fa-solid fa-table"></i>' : '<i class="fa-solid fa-grip"></i>';
      render();
    }

    // Get filtered items
    function getFilteredItems() {
      let list = availabilityData.items || [];
      if (currentFilter !== 'all') {
        list = list.filter(item => item.situation === currentFilter);
      }
      const wilaya = document.getElementById('wilayaFilter')?.value || 'all';
      if (wilaya !== 'all') {
        list = list.filter(item => (item.locationCity || '').includes(wilaya));
      }
      if (searchQuery) {
        list = list.filter(item => {
          const tName = (item.truckName || '').toLowerCase();
          const tImm = (item.immatriculation || '').toLowerCase();
          const dName = (item.driver?.name || '').toLowerCase();
          const dPhone = (item.driver?.phone || '').toLowerCase();
          const trImm = (item.trailer?.immatriculation || '').toLowerCase();
          const loc = (item.locationCity || '').toLowerCase();
          return tName.includes(searchQuery) || tImm.includes(searchQuery) || dName.includes(searchQuery) || dPhone.includes(searchQuery) || trImm.includes(searchQuery) || loc.includes(searchQuery);
        });
      }
      return list;
    }

    // Render
    function render() {
      const container = document.getElementById('contentContainer');
      const items = getFilteredItems();

      if (items.length === 0) {
        container.innerHTML = `
          <div class="empty-state">
            <i class="fa-solid fa-truck-ramp-box"></i>
            <div style="font-size:14px; font-weight:700; color:var(--text-secondary);">Aucun véhicule ne correspond aux critères sélectionnés.</div>
            <div style="font-size:12px; margin-top:4px;">Modifiez votre recherche ou réinitialisez les filtres.</div>
          </div>`;
        return;
      }

      if (viewMode === 'table') {
        renderTable(items, container);
      } else {
        renderCards(items, container);
      }
    }

    // Table view
    function renderTable(items, container) {
      let html = `
        <div class="table-container">
          <table>
            <thead>
              <tr>
                <th>Camion Tracteur</th>
                <th>Chauffeur Titulaire</th>
                <th>Remorque Attelée</th>
                <th>Situation Actuelle</th>
                <th>Localisation Live</th>
                <th>Vitesse & Télématique</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>`;

      items.forEach(item => {
        const mapsUrl = `https://www.google.com/maps?q=${item.lat || 0},${item.lng || 0}&t=k&z=17`;
        html += `
          <tr>
            <td>
              <strong style="color:var(--text-primary); font-size:13px;">${item.truckName}</strong>
              <div style="display:flex; gap:4px; margin-top:4px; flex-wrap:wrap;">
                ${item.immatriculation ? `<span class="truck-tag tag-imm">${item.immatriculation}</span>` : ''}
                ${item.carteNaftal ? `<span class="truck-tag tag-naftal"><i class="fa-solid fa-credit-card"></i> ${item.carteNaftal}</span>` : ''}
              </div>
            </td>
            <td>
              ${item.driver ? `
                <div style="font-weight:700; color:var(--primary); font-size:13px;">
                  <i class="fa-solid fa-user"></i> ${item.driver.name}
                </div>
                ${item.driver.phone ? `
                  <a href="tel:${item.driver.phone}" class="call-link" title="Appeler le chauffeur">
                    <i class="fa-solid fa-phone"></i> ${item.driver.phone}
                  </a>
                ` : '<span style="color:var(--text-muted); font-size:11px;">Sans tél</span>'}
              ` : '<em style="color:var(--text-muted);">Non assigné</em>'}
            </td>
            <td>
              ${item.trailer ? `
                <div style="font-weight:700; color:#c084fc;">
                  <span class="truck-tag tag-trailer"><i class="fa-solid fa-trailer"></i> ${item.trailer.immatriculation}</span>
                </div>
                <div style="font-size:11px; color:var(--text-muted); margin-top:2px;">${item.trailer.type || 'Plateau'}</div>
              ` : '<em style="color:var(--text-muted);">Sans remorque</em>'}
            </td>
            <td>
              <span class="situation-badge ${item.situationBadge}">
                ${item.isMoving ? '<span class="pulse-dot" style="width:6px; height:6px;"></span>' : ''}
                ${item.situationLabel}
              </span>
            </td>
            <td>
              <div style="display:flex; align-items:center; gap:6px;">
                <i class="fa-solid fa-location-dot" style="color:var(--primary);"></i>
                <span style="font-weight:600; color:var(--text-primary);">${item.locationCity || 'En route'}</span>
              </div>
            </td>
            <td>
              <div style="font-weight:700; color:${item.speed >= 1 ? '#10b981' : 'var(--text-muted)'}; font-family:var(--font-mono);">
                ${item.speed} km/h
              </div>
              <div style="font-size:11px; color:var(--text-muted); margin-top:2px;">
                ${item.fuelLiters ? `${item.fuelLiters}L (${item.fuelPercent}%)` : ''}
                ${item.odometer ? ` · ${item.odometer.toLocaleString()} km` : ''}
              </div>
            </td>
            <td>
              <a href="${mapsUrl}" target="_blank" class="btn btn-back" style="padding:5px 10px; font-size:11px;" title="Voir satellite Google Maps">
                <i class="fa-solid fa-map-location-dot"></i> GPS
              </a>
            </td>
          </tr>`;
      });

      html += `</tbody></table></div>`;
      container.innerHTML = html;
    }

    // Cards view
    function renderCards(items, container) {
      let html = `<div class="cards-grid">`;
      items.forEach(item => {
        const mapsUrl = `https://www.google.com/maps?q=${item.lat || 0},${item.lng || 0}&t=k&z=17`;
        html += `
          <div class="dispo-card" style="border-top: 3px solid ${item.situationColor};">
            <div class="dispo-card-header">
              <div>
                <strong style="font-size:14px;">${item.truckName}</strong>
                <div style="font-size:11px; color:var(--text-secondary); margin-top:2px;">${item.immatriculation || 'Sans plaque'}</div>
              </div>
              <span class="situation-badge ${item.situationBadge}">${item.situationLabel}</span>
            </div>
            <div class="dispo-card-body">
              <div class="info-row">
                <span class="info-label"><i class="fa-solid fa-user"></i> Chauffeur</span>
                <span class="info-value">
                  ${item.driver ? `
                    ${item.driver.name}
                    ${item.driver.phone ? `<br><a href="tel:${item.driver.phone}" class="call-link"><i class="fa-solid fa-phone"></i> ${item.driver.phone}</a>` : ''}
                  ` : '<em style="color:var(--text-muted);">Non assigné</em>'}
                </span>
              </div>
              <div class="info-row">
                <span class="info-label"><i class="fa-solid fa-trailer"></i> Remorque</span>
                <span class="info-value">${item.trailer ? `${item.trailer.immatriculation} (${item.trailer.type || 'Plateau'})` : '<em style="color:var(--text-muted);">Aucune</em>'}</span>
              </div>
              <div class="info-row">
                <span class="info-label"><i class="fa-solid fa-location-dot"></i> Localisation</span>
                <span class="info-value">${item.locationCity || 'En route'}</span>
              </div>
              <div class="info-row">
                <span class="info-label"><i class="fa-solid fa-gauge"></i> Vitesse & Carburant</span>
                <span class="info-value" style="font-family:var(--font-mono);">${item.speed} km/h · ${item.fuelLiters || 0}L</span>
              </div>
              <div style="margin-top:10px; display:flex; justify-content:flex-end;">
                <a href="${mapsUrl}" target="_blank" class="btn btn-back" style="width:100%; justify-content:center; padding:7px 12px; font-size:11px;">
                  <i class="fa-solid fa-map-location-dot"></i> Voir sur Google Maps
                </a>
              </div>
            </div>
          </div>`;
      });
      html += `</div>`;
      container.innerHTML = html;
    }

    // Native Excel Export via ExcelJS
    async function exportToExcel() {
      if (typeof ExcelJS === 'undefined') {
        alert('Erreur: ExcelJS non chargé.');
        return;
      }
      const items = getFilteredItems();
      const workbook = new ExcelJS.Workbook();
      workbook.creator = 'Douroub FleetOS';
      const sheet = workbook.addWorksheet('Disponibilité Flotte', {
        views: [{ showGridLines: true }]
      });

      sheet.columns = [
        { header: 'Camion', key: 'truck', width: 22 },
        { header: 'Immatriculation', key: 'imm', width: 18 },
        { header: 'Carte Naftal', key: 'naftal', width: 16 },
        { header: 'Chauffeur', key: 'driver', width: 24 },
        { header: 'Tél Chauffeur', key: 'phone', width: 18 },
        { header: 'Remorque Attelée', key: 'trailer', width: 20 },
        { header: 'Type Remorque', key: 'trailerType', width: 20 },
        { header: 'Situation', key: 'situation', width: 22 },
        { header: 'Localisation', key: 'location', width: 22 },
        { header: 'Vitesse (km/h)', key: 'speed', width: 14 },
        { header: 'Odomètre (km)', key: 'odo', width: 16 },
        { header: 'Carburant (L)', key: 'fuel', width: 16 }
      ];

      // Header styling
      const headerRow = sheet.getRow(1);
      headerRow.height = 28;
      headerRow.font = { name: 'Calibri', size: 11, bold: true, color: { argb: 'FFFFFFFF' } };
      headerRow.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FF0D7F91' } };
      headerRow.alignment = { vertical: 'middle', horizontal: 'center' };

      items.forEach((item, index) => {
        const row = sheet.addRow({
          truck: item.truckName,
          imm: item.immatriculation || '',
          naftal: item.carteNaftal || '',
          driver: item.driver?.name || 'Non assigné',
          phone: item.driver?.phone || '',
          trailer: item.trailer?.immatriculation || '',
          trailerType: item.trailer?.type || '',
          situation: item.situationLabel || item.situation,
          location: item.locationCity || '',
          speed: item.speed || 0,
          odo: item.odometer || 0,
          fuel: item.fuelLiters || 0
        });

        row.height = 20;
        const isEven = index % 2 === 0;
        row.fill = {
          type: 'pattern',
          pattern: 'solid',
          fgColor: { argb: isEven ? 'FFFFFFFF' : 'FFF8FAFC' }
        };
      });

      const buffer = await workbook.xlsx.writeBuffer();
      const blob = new Blob([buffer], { type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `Suivi_Disponibilite_${new Date().toISOString().slice(0, 10)}.xlsx`;
      a.click();
      URL.revokeObjectURL(url);
    }

    // Auto-polling every 10 seconds
    fetchAvailability();
    pollInterval = setInterval(fetchAvailability, 10000);
  </script>
</body>
</html>
